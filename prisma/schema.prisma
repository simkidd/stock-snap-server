// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// 1. Multi-Tenant Core: Business & Store Hierarchy
// -------------------------------------------------------------

model Tenant {
  id                 String              @id @default(cuid())
  name               String              // e.g. "StockSnap Supermarket"
  slug               String              @unique
  currency           String              @default("NGN")
  phone              String?
  email              String?
  address            String?             // e.g. "Peter Odili Road"
  city               String?             @default("Port Harcourt")
  state              String?             @default("Rivers State")
  country            String?             @default("Nigeria")
  cacNumber          String?             // Corporate Affairs Commission RC/BN
  vatTIN             String?             // Tax Identification Number
  logoUrl            String?
  stores             Store[]
  users              User[]
  products           Product[]
  categories         Category[]
  brands             Brand[]
  suppliers          Supplier[]
  customers          Customer[]
  discounts          Discount[]
  sales              Sales[]
  registers          Register[]
  registerSessions   RegisterSession[]
  stockMovements     StockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("tenants")
}

model Store {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String              // e.g. "Port Harcourt Main Branch"
  slug               String
  address            String?             // e.g. "Plot 12, Peter Odili Road, Trans-Amadi"
  city               String?             @default("Port Harcourt")
  state              String?             @default("Rivers State")
  phone              String?
  receiptHeader      String?             // Custom text at top of thermal receipt
  receiptFooter      String?             // Return policy e.g. "No refund of money after payment"
  defaultVatRate     Decimal             @default(7.5) // Standard Nigerian VAT (7.5%)
  isMainStore        Boolean             @default(true)
  registers          Register[]
  sales              Sales[]
  users              User[]
  stockMovements     StockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([tenantId, slug])
  @@map("stores")
}

// -------------------------------------------------------------
// 2. Registers & Cashier Shifts (Z-Reports / Float Balancing)
// -------------------------------------------------------------

model Register {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId            String
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name               String              // e.g. "Counter 1", "Fast Lane Register"
  code               String              // e.g. "REG-01"
  sessions           RegisterSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([storeId, code])
  @@map("registers")
}

model RegisterSession {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registerId         String
  register           Register            @relation(fields: [registerId], references: [id], onDelete: Cascade)
  cashierId          String
  cashier            User                @relation(fields: [cashierId], references: [id])
  openingFloat       Decimal             @default(0) // Starting cash change in drawer (e.g. ₦10,000)
  closingCash        Decimal?            // Cash counted physically at shift end
  expectedCash       Decimal?            // Float + Total Cash Sales
  difference         Decimal?            // Overage / Shortage (closingCash - expectedCash)
  status             SessionStatusEnum   @default(OPEN)
  note               String?
  openedAt           DateTime            @default(now())
  closedAt           DateTime?
  sales              Sales[]

  @@map("register_sessions")
}

// -------------------------------------------------------------
// 3. Customer CRM & Store Credit / Debt Ledger
// -------------------------------------------------------------

model Customer {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  phoneNumber        String              // Key identifier at checkout
  email              String?
  address            String?
  storeCreditBalance Decimal             @default(0) // Balance left from change or returns
  totalDebt          Decimal             @default(0) // Unpaid credit sales
  debtLimit          Decimal             @default(0) // Maximum allowed credit limit
  sales              Sales[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([tenantId, phoneNumber])
  @@map("customers")
}

// -------------------------------------------------------------
// 4. Products, Inventory & Break-bulk Packs
// -------------------------------------------------------------

model Product {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Core Identity & Classification
  name              String
  slug              String
  description       String?
  tags              String[]

  // SKU & Barcode (Master/Simple)
  sku               String
  barcode           String?

  // Variant Architecture
  hasVariants       Boolean           @default(false)
  options           Json?             // e.g. [{ "name": "Size", "values": ["S", "M", "L"] }]

  // Pricing & Financials (in ₦)
  costPrice         Decimal           @default(0)
  price             Decimal           // Selling price (or starting base price for variant items)
  isTaxExempt       Boolean           @default(false) // 7.5% Nigerian VAT toggle

  // Stock, Alerts & FMCG Units
  quantity          Int               @default(0) // Live aggregate on-hand stock
  minimumQuantity   Int               @default(5) // Low stock alert threshold
  status            ProductStatusEnum @default(AVAILABLE)
  unit              String?           @default("pieces") // pieces, carton, pack, bottle, kg, litre, rolls
  piecesPerPack     Int?              @default(1) // Break-bulk carton conversion
  expiryDate        DateTime?         // Perishables and pharma expiration

  // Relations
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId           String?
  brand             Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplierId        String?
  Supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Audit
  addedById         String
  addedBy           User              @relation("addedBy", fields: [addedById], references: [id])
  updatedById       String?
  updatedBy         User?             @relation("updatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Child Relations
  variants          ProductVariant[]
  images            ProductImage[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ProductVariant {
  id                String            @id @default(cuid())
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  name              String            // e.g. "Size 42 / Black" or "100ml / EDP"
  sku               String            // Unique Variant SKU e.g. "NK-AF1-BLK-42"
  barcode           String?           // Variant-specific barcode for laser scanners
  imageUrl          String?           // Variant-specific photo/swatch

  costPrice         Decimal           @default(0)
  price             Decimal           // Specific variant selling price in ₦
  quantity          Int               @default(0) // Specific variant stock count
  minimumQuantity   Int               @default(5) // Low stock threshold
  isActive          Boolean           @default(true)

  attributes        Json?             // e.g. { "Size": "42", "Color": "Black" }

  saleItems         SaleItem[]
  stockMovements    StockMovement[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model Brand {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String?
  publicId  String?
  slug      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@map("brands")
}

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("SubCategories")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, slug])
  @@map("categories")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  publicId  String
  imageUrl  String
  isMain    Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

model StockMovement {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId        String?
  store          Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  type           StockMovementType // PURCHASE, SALE, RETURN, ADJUSTMENT, BREAK_BULK
  quantityChange Int               // Positive or negative
  reason         String?           // e.g. "Carton opened for piece sales", "Damaged goods"
  createdAt      DateTime          @default(now())

  @@map("stock_movements")
}

// -------------------------------------------------------------
// 5. Sales, POS Checkout, Split Payments & Cash Balance
// -------------------------------------------------------------

model Sales {
  id                  String               @id @default(cuid())
  invoiceNo           String               @unique // e.g. "INV-2026-0001"
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId             String?
  store               Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  registerSessionId   String?
  registerSession     RegisterSession?     @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  cashierId           String
  cashier             User                 @relation(fields: [cashierId], references: [id])
  customerId          String?
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Financial Breakdown (in ₦)
  subTotalAmount      Decimal              @default(0) // Items sum before tax and discount
  taxAmount           Decimal              @default(0) // 7.5% VAT (if applicable)
  discountAmount      Decimal              @default(0) // Deducted discount
  totalAmount         Decimal              @default(0) // Final Net Amount to pay
  totalQuantity       Int                  @default(0)

  // Cash Change & Tendered Calculations
  amountTendered      Decimal?             @default(0) // Amount given by customer (e.g. ₦20,000)
  changeDue           Decimal?             @default(0) // Balance returned to customer (e.g. ₦5,700)
  
  paymentMethod       PaymentMethodEnum    @default(CASH) // Primary or SPLIT
  paymentStatus       PaymentStatusEnum    @default(PAID) // PAID, PARTIALLY_PAID, PENDING
  
  discountId          String?
  discount            Discount?            @relation(fields: [discountId], references: [id])
  saleItems           SaleItem[]
  paymentTransactions PaymentTransaction[]
  
  note                String?
  posNumber           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("sales")
}

model SaleItem {
  id          String          @id @default(cuid())
  saleId      String
  sale        Sales           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity    Int
  unitPrice   Decimal  // Selling price per item
  costPrice   Decimal  @default(0) // Cost price at moment of sale (for accurate historical profit)
  totalAmount Decimal  // quantity * unitPrice
  description String?

  @@map("sale_items")
}

model PaymentTransaction {
  id                String            @id @default(cuid())
  tenantId          String
  saleId            String
  sale              Sales             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod     PaymentMethodEnum // CASH, POS_CARD, BANK_TRANSFER, STORE_CREDIT
  amount            Decimal           // Portion paid via this channel
  
  // Nigerian Payment Details
  bankName          String?           // For Bank Transfer (e.g. "GTBank", "OPay", "Moniepoint")
  transferReference String?           // Session ID or NIP Ref
  posTerminalName   String?           // e.g. "Moniepoint Terminal 1"
  posRrnNumber      String?           // Retrieval Reference Number from POS terminal receipt
  note              String?
  createdAt         DateTime          @default(now())

  @@map("payment_transactions")
}

// -------------------------------------------------------------
// 6. User Management & Authentication Models
// -------------------------------------------------------------

model User {
  id               String            @id @default(cuid())
  firstName        String            @default("")
  middleName       String?
  lastName         String            @default("")
  gender           String?
  avatar           String?
  avatarId         String?
  email            String            @unique
  role             UserRole          @default(CASHIER)
  status           UserStatusEnum    @default(ACTIVE)
  phoneNumber      String?
  address          String?

  tenantId         String?
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId          String?
  store            Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)

  auth             Auth?
  addedProducts    Product[]         @relation("addedBy")
  updatedProducts  Product[]         @relation("updatedBy")
  sales            Sales[]
  registerSessions RegisterSession[]
  stockMovements   StockMovement[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("users")
}

model Auth {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  password         String
  pinCode          String?           // Hashed 4-digit PIN for cashier quick lock/unlock & manager override
  isEmailVerified  Boolean           @default(false)
  emailToken       String?           // OTP reset / verification code
  tokenExpiresAt   DateTime?         // OTP expiration
  refreshToken     String?           // Hashed refresh token
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("auths")
}

// -------------------------------------------------------------
// 7. Discounts, Suppliers & Orders
// -------------------------------------------------------------

model Discount {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  description String?
  percentage  Float     @default(0.0)
  startDate   DateTime
  endDate     DateTime
  sales       Sales[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, code])
  @@map("discounts")
}

model Supplier {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  contactPhone   String?
  contactAddress String?
  slug           String
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@map("suppliers")
}

// -------------------------------------------------------------
// 8. Enums
// -------------------------------------------------------------

enum ProductStatusEnum {
  AVAILABLE
  OUT
  LOW
}

enum SessionStatusEnum {
  OPEN
  CLOSED
}

enum PaymentMethodEnum {
  CASH
  POS_CARD
  BANK_TRANSFER
  STORE_CREDIT
  SPLIT
}

enum PaymentStatusEnum {
  PAID
  PARTIALLY_PAID
  PENDING
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  BREAK_BULK
}

enum UserRole {
  ADMIN
  STORE_MANAGER
  CASHIER
  SALES_REP
  INVENTORY_CONTROLLER
  ACCOUNTANT
  SUPPLIER_MANAGER
  STAFF
  MANAGER
  SUPPORT
}

enum UserStatusEnum {
  ACTIVE
  INACTIVE
  SUSPENDED
}
